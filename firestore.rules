rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Legacy and untouched collections: explicitly deny all access
    match /xusers/{document=**} {
      allow read, write: if false;
    }
    match /xworkspaces/{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Obsolete Password Encryption Metadata Collection
    // Cloud encryption layer removed in favor of direct plaintext storage in workspaces
    // Explicitly deny all access to prevent unauthorized reads/writes
    // -------------------------------------------------------------
    match /password_crypto/{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Users Collection
    // Document ID must match the Firebase Authentication UID
    // Strictly limited to 8 profile fields
    // -------------------------------------------------------------
    match /users/{userId} {
      // Allow user to read only their own full profile
      allow get: if request.auth != null && request.auth.uid == userId;
      // Disallow querying/listing full user documents
      allow list: if false;

      // Allow creation of own profile on registration/login
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.user_status == 1
                    && request.resource.data.user_login_provider in ['GOOGLE', 'ANONYMOUS']
                    && !('password_crypto' in request.resource.data)
                    && request.resource.data.keys().hasOnly([
                         'user_id',
                         'user_name',
                         'user_email',
                         'user_dp_link',
                         'user_login_provider',
                         'user_at_created',
                         'user_at_last_visit',
                         'user_status'
                       ]);

      // Allow updates to user profile fields
      // Ensure user_id cannot be changed and user_at_created is never modified
      // Restrict all updates to an explicit allowlist of permitted fields using diff().affectedKeys()
      // Disallow setting/updating password_crypto in users/{userId} (allow only deletion during migration)
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.user_id == resource.data.user_id
                    && request.resource.data.user_id == request.auth.uid
                    && (!('user_at_created' in resource.data) || request.resource.data.user_at_created == resource.data.user_at_created)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'user_name',
                         'user_email',
                         'user_dp_link',
                         'user_at_last_visit',
                         'user_login_provider',
                         'password_crypto'
                       ])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['password_crypto'])
                        || !('password_crypto' in request.resource.data));

      // Client-side user deletion is forbidden
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // User Directory Collection (Minimal Collaborator Discovery)
    // Strictly limited to 4 discovery fields; full users/{userId} remains private
    // -------------------------------------------------------------
    match /user_directory/{userId} {
      // Authenticated users can resolve directory profiles by UID and perform bounded email lookups
      allow get: if request.auth != null;
      allow list: if request.auth != null
                  && request.query.limit != null
                  && request.query.limit <= 5;

      // Users can create/update only their own directory entry with the 4 allowed fields
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.user_id == request.auth.uid
                            && request.resource.data.keys().hasOnly([
                                 'user_id',
                                 'user_email',
                                 'user_name',
                                 'user_dp_link'
                               ]);

      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Workspaces Collection
    // Document ID matches the Social HUB workspace ID
    // -------------------------------------------------------------
    match /workspaces/{workspaceId} {
      // Read allowed if document doesn't exist yet (for existence check) or user is workspace owner or listed in ws_users_ids
      allow get: if request.auth != null && (
        resource == null ||
        resource.data.ws_owner_id == request.auth.uid ||
        (resource.data.ws_users_ids is list && request.auth.uid in resource.data.ws_users_ids)
      );

      // List allowed for queries filtering where user is owner or authorized member
      allow list: if request.auth != null && (
        resource.data.ws_owner_id == request.auth.uid ||
        request.auth.uid in resource.data.ws_users_ids
      );

      // Workspace creation:
      // Must be authenticated, ws_id must match docId, ws_owner_id must match auth.uid,
      // ws_status must be 1, and ws_users_ids must contain owner auth.uid
      allow create: if request.auth != null
                    && request.resource.data.ws_id == workspaceId
                    && request.resource.data.ws_owner_id == request.auth.uid
                    && request.resource.data.ws_status == 1
                    && (request.resource.data.ws_users_ids is list && request.auth.uid in request.resource.data.ws_users_ids)
                    && (!('ws_passwords' in request.resource.data) || request.resource.data.ws_passwords is list);

      // Workspace updates:
      // - Workspace owner can update workspace data and manage collaborator membership (ws_users_ids),
      //   but CANNOT alter ws_id, ws_owner_id, ws_at_created, or remove themselves from ws_users_ids.
      // - Listed collaborators can only update ws_at_last_visit when opening/switching into the workspace,
      //   and CANNOT modify ws_users_ids, ws_owner_id, accounts, passwords, or metadata.
      allow update: if request.auth != null
                    && request.resource.data.ws_id == resource.data.ws_id
                    && request.resource.data.ws_owner_id == resource.data.ws_owner_id
                    && (!('ws_at_created' in resource.data) || request.resource.data.ws_at_created == resource.data.ws_at_created)
                    && (
                      (
                        resource.data.ws_owner_id == request.auth.uid
                        && request.resource.data.ws_users_ids is list
                        && resource.data.ws_owner_id in request.resource.data.ws_users_ids
                        && (!('ws_passwords' in request.resource.data) || request.resource.data.ws_passwords is list)
                      )
                      ||
                      (
                        resource.data.ws_owner_id != request.auth.uid
                        && resource.data.ws_users_ids is list
                        && request.auth.uid in resource.data.ws_users_ids
                        && request.resource.data.ws_users_ids == resource.data.ws_users_ids
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ws_at_last_visit'])
                      )
                    );

      // Workspace deletion:
      // Only the workspace owner can delete the workspace document
      allow delete: if request.auth != null && resource.data.ws_owner_id == request.auth.uid;
    }
  }
}
